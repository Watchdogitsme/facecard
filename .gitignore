# =====================================================================
# Git Ignore Configuration for FaceCard (CV_MINIprj)
# =====================================================================

# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# User runtime snapshots and captures (preserves .gitkeep)
snapshots/*.jpg
snapshots/*.png
snapshots/*.jpeg
!snapshots/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs & Editor Configuration
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Logs and temporary files
*.log
*.tmp
*.part
*.bak
